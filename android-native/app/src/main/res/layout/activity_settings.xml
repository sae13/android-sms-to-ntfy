<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate_950"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Server URL -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/ntfy_server_url"
            app:boxStrokeColor="@color/teal_200"
            app:hintTextColor="@color/slate_400">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etServerUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:textColor="@color/white"
                android:backgroundTint="@color/slate_800" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Topic -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/ntfy_topic"
            app:boxStrokeColor="@color/teal_200"
            app:hintTextColor="@color/slate_400">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTopic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="@color/white"
                android:backgroundTint="@color/slate_800" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Username -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/ntfy_username"
            app:boxStrokeColor="@color/teal_200"
            app:hintTextColor="@color/slate_400">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="@color/white"
                android:backgroundTint="@color/slate_800" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/ntfy_password"
            app:boxStrokeColor="@color/teal_200"
            app:hintTextColor="@color/slate_400">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="@color/white"
                android:backgroundTint="@color/slate_800" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Priority Spinner -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ntfy Priority"
            android:textColor="@color/slate_400"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerPriority"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/slate_800"
            android:spinnerMode="dropdown" />

        <!-- Forwarding switches -->
        <CheckBox
            android:id="@+id/cbEnableSms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_sms_forwarding"
            android:textColor="@color/white"
            android:checked="true"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/cbEnableCalls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_call_forwarding"
            android:textColor="@color/white"
            android:checked="true"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/cbEnableCallNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="نوتیفیکیشن بابت لاگ ارسال تماس"
            android:textColor="@color/white"
            android:checked="true"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/cbUseBase64"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Use Base64 Encoding (UTF-8/Persian)"
            android:textColor="@color/white"
            android:checked="true"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="@string/deltachat_destination"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <CheckBox
            android:id="@+id/cbEnableDeltaChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/enable_deltachat"
            android:textColor="@color/white" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/deltachat_login_code">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDeltaChatLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="@color/white" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/deltachat_invite">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDeltaChatInvite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:textColor="@color/white" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnSetupDeltaChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/setup_deltachat" />

        <Button
            android:id="@+id/btnTestDeltaChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/test_deltachat" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="@string/telegram_destination"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <CheckBox
            android:id="@+id/cbEnableTelegram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/enable_telegram"
            android:textColor="@color/white" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/telegram_bot_token">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTelegramBotToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="@color/white" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/telegram_chat_id">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTelegramChatId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number|numberSigned"
                android:textColor="@color/white" />
        </com.google.android.material.textfield.TextInputLayout>

        <CheckBox
            android:id="@+id/cbEnableAether"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_aether"
            android:textColor="@color/white"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/cbAetherAlwaysOn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_aether_always"
            android:textColor="@color/white"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/cbAetherPublicProxy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_aether_public"
            android:textColor="@color/white"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvAetherPublicWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/aether_public_warning"
            android:textColor="@android:color/holo_red_light"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvAetherStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/slate_400"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnFindFastestAether"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/find_fastest_aether" />

        <Button
            android:id="@+id/btnTestTelegram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/test_telegram" />

        <!-- Buttons -->
        <Button
            android:id="@+id/btnTestConnection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/test_connection"
            android:backgroundTint="@color/teal_700"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_settings"
            android:backgroundTint="@color/purple_700"
            android:textColor="@color/white" />

    </LinearLayout>
</ScrollView>
